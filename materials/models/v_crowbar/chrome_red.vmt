"VertexLitGeneric"
{
	"$color2" "[1 1 1]"
	"$envmap" "models/v_crowbar/chrome_cammo"
	"$envmapmode" 1
	"$envmapsphere" 1	

	// requred to see specular on dx6+7 at all
	"$multipass" 1

	"$detailblendmode" 2

	Proxies {
		CustomCamo {
			camoTexture $detail
			camoScale $detailscale
            blend $detailblendfactor
		}
	}

}
